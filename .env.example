ENV=local

DATABASE_URL=postgresql+psycopg2://postgres:postgres@postgres:5432/upazila
REDIS_URL=redis://redis:6379/0

JWT_SECRET_KEY=change-me-to-a-random-secret
JWT_ALGORITHM=HS256
# Encrypts secret admin settings (API keys) at rest. Optional - falls back to
# JWT_SECRET_KEY if unset. Set a distinct random value in production.
SETTINGS_ENCRYPTION_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30

CORS_ORIGINS=["http://localhost:3000"]

# Media uploads (Section 6 free-hosting setup) - client uploads straight to
# Cloudinary using a signature from /uploads/signature. Empty = disabled.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Phase 2 ---
# Phone OTP: "console" logs the code + echoes it in the API response (dev only). Use "http" with a real gateway in production.
SMS_GATEWAY=console
SMS_HTTP_URL=
SMS_HTTP_API_KEY=
SMS_SENDER_ID=Upazila
# Cloudflare Turnstile secret for the OTP-request endpoint (Section 14.1). Empty = challenge skipped.
TURNSTILE_SECRET_KEY=
# Facebook Login (Section 16.2) — server-side Graph API verification
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
# Google Login (same pattern) — server-side ID token verification, no secret needed
GOOGLE_CLIENT_ID=
AUTO_APPROVE_TRUST_SCORE=3
EXCHANGE_LISTING_TTL_DAYS=30

# Mobile app version gate (Section 8.7) - overridable from Admin > Settings
MIN_SUPPORTED_APP_VERSION=0.1.0
LATEST_APP_VERSION=0.1.0
